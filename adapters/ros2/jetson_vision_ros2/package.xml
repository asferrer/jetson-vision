<?xml version="1.0"?>
<package format="3">
  <name>jetson_vision_ros2</name>
  <version>0.1.0</version>
  <description>ROS 2 Humble adapter of the jetson-vision core: no vision logic, only message mapping</description>
  <maintainer email="maintainer@example.com">jetson-vision maintainers</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>vision_msgs</depend>
  <depend>diagnostic_msgs</depend>
  <depend>jetson_vision_msgs</depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
